# Heavenward — pnpm hardening
# Mitigations against npm supply-chain worms (Shai-Hulud-class)

# Pin the package manager via corepack (also via packageManager in package.json)
package-manager-strict=true
engine-strict=true

# Block dependency lifecycle scripts by default. Only the packages listed in
# package.json -> pnpm.onlyBuiltDependencies are allowed to run install/postinstall.
# This is the primary defence against malicious package install hooks.
ignore-scripts=false
dangerously-allow-all-builds=false

# Refuse to install from anything but the official registry.
registry=https://registry.npmjs.org/

# Require lockfile parity in production installs.
frozen-lockfile=true

# Surface advisories on every install.
audit-level=moderate

# Reproducible installs.
prefer-frozen-lockfile=true
resolution-mode=highest

# Reject git: / http: dependencies (only registry tarballs allowed).
git-shallow-hosts=
