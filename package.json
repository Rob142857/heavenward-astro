{
  "name": "heavenward",
  "version": "1.0.1",
  "description": "Dusk-till-dawn astronomical event report — everything visible tonight, one tap away",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build",
    "preview": "wrangler pages dev dist",
    "deploy": "pnpm run deploy:production",
    "deploy:production": "pnpm run build && wrangler pages deploy dist --branch production",
    "deploy:preview": "pnpm run build && wrangler pages deploy dist --branch preview",
    "typecheck": "tsc --noEmit && pnpm run check:i18n && pnpm run check:data",
    "check:i18n": "node --experimental-strip-types scripts/check-i18n.ts",
    "check:data": "node --experimental-strip-types scripts/check-sky-data.ts",
    "audit": "pnpm audit --audit-level=moderate",
    "refresh": "node --experimental-strip-types scripts/refresh-catalog.ts",
    "catalog:plan": "node --experimental-strip-types scripts/refresh-catalog.ts --plan"
  },
  "keywords": [
    "astronomy",
    "stargazing",
    "pwa",
    "cloudflare-workers",
    "ephemeris"
  ],
  "author": "Rob142857",
  "license": "Apache-2.0",
  "dependencies": {
    "@cloudflare/workers-types": "^4.20260509.1",
    "@hono/node-server": "^2.0.2",
    "@litert-lm/core": "^0.15.0",
    "@mlc-ai/web-llm": "^0.2.83",
    "astronomy-engine": "^2.1.19",
    "hono": "^4.12.18",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-precaching": "^7.4.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.90.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "sharp": "^0.34.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd",
      "@cloudflare/workerd-darwin-64",
      "@cloudflare/workerd-darwin-arm64",
      "@cloudflare/workerd-linux-64",
      "@cloudflare/workerd-linux-arm64",
      "@cloudflare/workerd-windows-64"
    ],
    "auditConfig": {
      "ignoreCves": []
    }
  }
}
